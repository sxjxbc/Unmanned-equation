<launch>
  <arg name="pose_topic" default="/vehicle_pose"/>
  <arg name="cones_topic" default="/clustered_points"/>
  <arg name="boundary_packet_topic" default="/trackdrive/input/confirmed_corridor"/>
  <arg name="config" default="$(find obstacle_avoidance_event)/config/planning_shadow.yaml"/>
  <node pkg="obstacle_avoidance_event" type="planning_shadow_node.py" name="trackdrive_planning_shadow" output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <param name="vehicle_output" value="false"/>
    <param name="pose_topic" value="$(arg pose_topic)"/>
    <param name="cones_topic" value="$(arg cones_topic)"/>
    <param name="boundary_packet_topic" value="$(arg boundary_packet_topic)"/>
  </node>
</launch>
