<launch>
  <arg name="log_dir" default="/tmp/path_tracking_logs"/>
  <arg name="can_dest_ip" default="192.168.0.7"/>
  <arg name="can_dest_port" default="20005"/>
  <arg name="can_self_port" default="11312"/>
  <arg name="enable_vehicle_output" default="true"/>
  <arg name="enable_visualization" default="true"/>
  <arg name="visualization_hz" default="5.0"/>
  <!-- Explicitly cache the existing rospy default; missing key causes an RPC per log. -->
  <param name="/rosout_disable_topics_generation" type="bool" value="false"/>

  <!-- 1. 建图节点 jiantu.py -->
  <node pkg="acceleration_event" type="jiantu.py" name="fsae_slam_node" output="screen">
    <param name="enable_visualization" value="$(arg enable_visualization)"/>
    <param name="visualization_hz" value="$(arg visualization_hz)"/>
    <param name="imu_init_wait_time" value="3.0"/>
    <param name="gps_lat_min" value="30.0"/>
    <param name="gps_lat_max" value="40.0"/>
    <param name="gps_lon_min" value="110.0"/>
    <param name="gps_lon_max" value="125.0"/>
    <param name="gps_max_speed_mps" value="8.0"/>
    <param name="gps_jump_tolerance_m" value="2.0"/>
    <param name="gps_max_gap_s" value="1.0"/>
    <param name="gps_max_age_s" value="0.5"/>
    <param name="gps_bootstrap_samples" value="3"/>
    <param name="imu_max_yaw_rate_dps" value="180.0"/>
    <param name="imu_jump_tolerance_deg" value="5.0"/>

    <param name="lidar_offset_x" value="1.76618"/>
    <param name="lidar_offset_y" value="-0.11304"/>
    <param name="lidar_offset_z" value="0.42850"/>
    <param name="lidar_y_sign" value="-1.0"/>
    <param name="lidar_yaw_offset_deg" value="0.5"/>

    <param name="cone_merge_distance" value="0.8"/>
    <param name="cone_timeout" value="6.0"/>
  </node>

  <!-- 2. 实时直线规划器 zhixian_realtime.py -->
  <node pkg="acceleration_event" type="zhixian_realtime.py" name="straight_line_planner_realtime" output="screen">
    <param name="track_width" value="3.15"/>
    <param name="total_length" value="175.0"/>
    <param name="local_path_length" value="30.0"/>
    <param name="path_point_spacing" value="0.5"/>
    <param name="blend_distance" value="6.0"/>

    <param name="local_min_x" value="0.5"/>
    <param name="local_max_x" value="24.0"/>
    <param name="local_max_abs_y" value="4.0"/>
    <param name="min_cone_confidence" value="0.15"/>
    <param name="max_local_cones" value="20"/>
    <param name="max_pair_count" value="2"/>
    <param name="pair_row_min_spacing" value="1.5"/>
    <param name="track_forward_min" value="-8.0" />
    <param name="track_forward_max" value="25.0" />

    <!-- Track width 2.7~3.6m; pair distances include measurement/skew margin. -->
    <param name="pair_distance_min" value="2.5"/>
    <param name="pair_distance_max" value="3.8"/>
    <param name="pair_max_longitudinal_diff" value="0.8"/>
    <param name="max_centerline_slope" value="0.25"/>

    <!-- atan(0.10) = 5.71 deg; keep fixed-reference direction checks. -->
    <param name="straight_slope_limit" value="0.10"/>
    <param name="max_slope_change" value="0.02"/>
    <param name="slope_alpha" value="0.12"/>

    <param name="centerline_alpha" value="0.15"/>
    <param name="centerline_timeout" value="0.50"/>
    <param name="max_center_offset" value="1.5"/>
    <param name="publish_hz" value="10.0"/>
  </node>

  <!-- 3. 路径跟踪控制器 genzong_realtime.py -->
  <node pkg="acceleration_event" type="genzong_realtime.py" name="path_tracking_controller" output="screen">
    <param name="enable_vehicle_output" value="$(arg enable_vehicle_output)"/>
    <!-- Reception/source age budgets, not stationary-position checks. -->
    <param name="guard_pose_timeout" value="0.8"/>
    <param name="guard_path_timeout" value="1.0"/>
    <param name="guard_road_timeout" value="1.0"/>
    <param name="track_width" value="3.15"/>
    <param name="cone_confidence_threshold" value="0.25"/>
    <param name="max_vehicle_speed_mps" value="4.1667"/>
    <param name="finish_distance" value="75.0"/>
    <param name="steering_sign" value="1.0"/>
    <param name="max_steering_step" value="0.012"/>
    <param name="fixed_speed" value="4.1667"/>

    <param name="kd_lateral" value="0.05"/>
    <param name="kd_heading" value="0.01"/>
    <param name="error_filter_alpha" value="0.12"/>

    <param name="heading_weight_min" value="0.35"/>
    <param name="heading_weight_full_lateral_error" value="0.80"/>
    <param name="max_lateral_derivative" value="0.60"/>
    <param name="max_heading_derivative" value="0.35"/>

    <param name="lookahead_min" value="2.5"/>
    <param name="lookahead_max" value="4.0"/>
    <param name="lookahead_speed_gain" value="0.35"/>

    <param name="local_cone_min_x" value="0.5"/>
    <param name="local_cone_max_x" value="18.0"/>
    <param name="local_cone_max_abs_y" value="4.0"/>
    <param name="max_local_cones" value="4"/>
    <param name="pair_distance_min" value="2.5"/>
    <param name="pair_distance_max" value="3.8"/>
    <param name="pair_max_dx" value="2.5"/>
    <param name="local_max_slope" value="0.30"/>
    <param name="local_timeout" value="0.35"/>
    <param name="local_blend_two_pairs" value="0.65"/>
    <param name="local_blend_one_pair" value="0.45"/>

    <param name="log_dir" value="$(arg log_dir)"/>
    <param name="can_dest_ip" value="$(arg can_dest_ip)"/>
    <param name="can_dest_port" value="$(arg can_dest_port)"/>
    <param name="can_self_port" value="$(arg can_self_port)"/>
    <param name="max_steering" value="0.50"/>
    <param name="kp_lateral" value="0.60"/>
    <param name="kp_heading" value="0.20"/>
  </node>
</launch>
